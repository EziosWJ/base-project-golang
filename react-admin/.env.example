# Vite base path: / for domain root; /your-subpath for subpath deployment.
VITE_BASE_PATH=/

# Full API prefix. Leave unset for same-origin /api/v1 (the default).
# Development requests are proxied to VITE_API_PROXY_TARGET.
# VITE_API_BASE_URL=http://127.0.0.1:8150/api/v1

# Vite dev-server proxy target for /api. Defaults to http://127.0.0.1:8150.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8100
